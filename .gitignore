# ==========================================
# SitePulse - Root .gitignore
# ==========================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!backend/.env.example

# Production & Build Outputs
dist/
dist-ssr/
build/
out/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Database & SQLite files (if used for local dev / backups)
*.sqlite
*.sqlite3
*.db
*.db-journal
*.dump
*.sql.gz

# Prisma Client Engine binaries
backend/prisma/*.db
backend/prisma/*.db-journal

# Editor & IDE Directories
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Testing & Coverage
coverage/
*.lcov
.nyc_output/

# Cache directories
.eslintcache
.cache/
.temp/
.tmp/
.turbo/
/references
*.pdf
/demo-site
