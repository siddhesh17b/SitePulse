# SitePulse root ignore rules

# Dependencies and package-manager state
node_modules/
.pnp
.pnp.js

# Environment variables and secrets
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key

# Build and deployment output
**/dist/
**/dist-ssr/
**/build/
**/out/
**/.next/
**/.vite/
.vercel/
.netlify/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local databases and dumps
*.sqlite
*.sqlite3
*.db
*.db-journal
*.dump
*.sql.gz

# Editor and IDE files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS-generated files
.DS_Store
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Testing and caches
coverage/
*.lcov
.nyc_output/
.eslintcache
.cache/
.temp/
.tmp/
.turbo/

# project unwanted
/references/
*.pdf
/demo-site/
demo-site/
*.pptx
